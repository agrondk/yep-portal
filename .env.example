APP_ENV=development
APP_NAME=YEP Portal API
API_V1_PREFIX=/api/v1
WEB_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
DATABASE_URL=postgresql+psycopg://yep:yep_dev_password@localhost:5432/yep
TEST_DATABASE_URL=postgresql+psycopg://yep:yep_test_password@localhost:5433/yep_test
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
TOKEN_TTL_MINUTES=30
INVITATION_TTL_DAYS=7
MFA_REQUIRED_FOR_PRIVILEGED=true
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
ORGANIZATION_TIMEZONE=Europe/Belgrade
DEFAULT_LOCALE=sq
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=yep_minio
S3_SECRET_KEY=change-me
S3_PRIVATE_BUCKET=yep-private
S3_REGION=us-east-1
FILE_MAX_BYTES=10485760
FILE_URL_TTL_SECONDS=300
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=yep_info@youngengineers.org
